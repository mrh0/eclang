use "core:io.ec"
use "core:path.ec"

fn main(): Int throws Error do
    io.log(path.join("logs", "2026", "today.txt"))
    io.log(path.join("logs/", "today.txt"))
    io.log(path.join("logs", "/abs", "x"))
    io.log(path.join("", "a"))
    io.log(path.join("a", ""))
    io.log(path.join("only"))
    io.log(path.base("a/b/c.txt"))
    io.log(path.base("a/b/"))
    io.log(path.base("/"))
    io.log(path.dir("a/b/c.txt"))
    io.log(path.dir("c.txt"))
    io.log(path.dir("/c.txt"))
    io.log(path.extension("a/photo.tar.gz"))
    io.log(path.extension("a.b/photo"))
    io.log(path.extension(".bashrc"))
    io.log(path.stem("a/photo.tar.gz"))
    io.log(path.stem(".bashrc"))
    io.log(path.withExtension("a/photo.jpg", "png"))
    io.log(path.withExtension("a/photo", "png"))
    io.log(path.withExtension("a/photo.jpg", ""))
    io.log(path.isAbsolute("/x"))
    io.log(path.isAbsolute("x"))
    io.log(path.normalize("a/./b/../c/"))
    io.log(path.normalize("/../a/.."))
    io.log(path.normalize("../../a"))
    io.log(path.normalize(""))
    io.log(try path.relative("/a/b", "/a/c/d"))
    io.log(try path.relative("/a/b", "/a/b"))
    val abs = try path.absolute("x/../y")
    io.log(path.isAbsolute(abs))
    io.log(path.base(abs))
    ret 0
