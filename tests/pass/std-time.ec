use "core:io.ec"
use "core:time.ec"

// core:time.ec: Time, Duration, the steady clock, calendar dates, ISO 8601 and duration text.
fn main(): Int throws Error do
    val start = time.instant()
    time.sleep(time.millis(20))
    val ms = time.toMillis(time.elapsed(start))
    io.log(ms >= 20 and ms < 200)
    val t = try time.parseIso("2024-02-29T12:30:00Z")
    io.log(time.unix(t))
    io.log(time.iso(t))
    io.log(time.iso(time.add(t, time.days(1))))
    val d = time.utc(t)
    io.log(d.weekday)
    io.log(time.weekdayName(d.weekday))
    io.log(time.strftime(d, "%A %d %B %Y"c))
    io.log(time.rfc822(t))
    io.log(time.iso(time.zoned(t, 3600)))
    io.log(time.iso(try time.parseIsoDate("2024-02-29 13:30:00.25+01:00")))
    io.log(time.iso(try time.parseIso("1969-12-31T23:59:59Z")))
    io.log(time.unix(try time.parseIso("1969-12-31T23:59:59Z")))
    io.log(time.text(time.add(time.hours(1), time.minutes(30))))
    io.log(time.text(time.millis(-1500)))
    io.log(time.text(time.millis(250)))
    io.log(time.toSeconds(try time.parseDuration("1h30m")))
    io.log(time.text(try time.parseDuration("2.5s")))
    io.log(time.text(time.parseDuration("5x") ?? time.seconds(0)))
    io.log(time.isoDate(try time.addMonths(try time.date(2024, 1, 31), 1)))
    io.log(time.isoDate(try time.addDays(try time.date(2024, 12, 31), 1)))
    io.log(time.isLeapYear(1900))
    io.log(time.daysInMonth(2024, 2))
    try time.date(2023, 2, 29) catch e do
        io.log(e.message)
    try time.parseIso("2024-13-01") catch e do
        io.log(e.message)
    io.log(time.isAfter(time.now(), t))
    val epoch = time.fromUnix(0)
    io.log(time.iso(epoch))
    io.log(time.iso(time.truncate(time.add(epoch, time.minutes(90)), time.hours(1))))
    io.log(time.compare(epoch, t))
    io.log(time.unixMillis(time.fromUnixMillis(1500)))
    io.log(time.inSeconds(time.millis(1500)))
    io.log(time.text(time.scale(time.seconds(90), 2)))
    io.log(time.text(time.between(t, epoch)))
    io.log(time.monthName(12))
    io.log(time.iso(time.zoned(t, -(5 * 3600 + 1800))))
    io.log(time.toSeconds(time.cpuTime()) >= 0)
    ret 0
