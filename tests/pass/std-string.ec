use "core:io.ec"
use "core:string.ec"

// core:string.ec: searching, slicing, changing, splitting, joining, parsing, UTF-8 and StringBuilder.
fn main(): Int do
    io.log(" Ada Lovelace ".trim().toUpper())
    val parts = "a, b, c".split(", ")
    io.log(parts.len)
    io.log(join(parts, ";"))
    io.log(parseDouble("2.5e3") ?? -1.0)
    io.log(parseDouble("2.5x") ?? -1.0)
    io.log(parseLong("-ff", 16) ?? 0)
    io.log(parseLong("0x7fffffffffffffff", 16) ?? 0)
    io.log(parseLong("-9223372036854775808", 10) ?? 0)
    io.log(parseLong("9223372036854775808", 10) ?? 0)
    io.log("hello world".replace("o", "0"))
    io.log("a-b-c".replace('-', '+'))
    io.log(repeat("ab", 3))
    io.log(padStart("7", 3, '0'))
    io.log(padEnd("ab", 5, '.'))
    io.log(center("hi", 6, '*'))
    io.log(toBase(-255, 16))
    io.log(hex(3735928559))
    io.log(reverse("abc"))
    io.log(capitalize("eclang"))
    io.log(count("aaaa", "aa"))
    io.log(lastIndexOf("a/b/c", "/") ?? 99)
    io.log(afterLast("a/b/c.txt", "/"))
    io.log(before("key=value", "="))
    io.log(after("key=value", "="))
    io.log(words("  one two\tthree  ").len)
    io.log(lines("x\r\ny\n").len)
    io.log(quote("say \"hi\"\n\x01"))
    io.log(compare("abc", "abd"))
    io.log(equalsIgnoreCase("Hello", "hELLO"))
    io.log(naturalCompare("file9", "file10"))
    io.log(hash("abc"))
    io.log(charCount("héllo"))
    io.log(isUtf8("héllo"))
    io.log(isUtf8("\xff"))
    io.log(parseBool("Yes") ?? false)
    val b = stringBuilder()
    for i in 0..<5 do
        b.append(i as Long)
        b.append(',')
    b.append("end"c)
    io.log(b.build())
    val text = "x=1;y=22;z=333"
    for pair in text.split(";") do
        io.log(concat(pair.before("="), " -> ", pair.after("=").padStart(4, '0')))
    io.log(isBlank("  \t"))
    io.log(trim("--x--", "-"))
    io.log(removePrefix("prefix-name", "prefix-"))
    io.log(take("hello", 2))
    io.log(drop("hello", 2))
    io.log(parseLong("12z", 10) ?? -1)
    try parseLong(" 12z", 10) catch e do
        io.log(e.message)
        io.log(e.position)
    io.log(fromC("from C"c))
    io.log(charString('q'))
    ret 0
